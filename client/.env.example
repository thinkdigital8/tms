# Leave empty for local dev — Vite's dev-server proxy (see vite.config.ts) forwards
# /api and /socket.io to http://localhost:4000.
#
# In production (e.g. deployed to Render as a static site), set this to the
# deployed backend's URL, with no trailing slash, e.g.:
# VITE_API_URL=https://tms-backend.onrender.com
VITE_API_URL=
